# Copiar como .env para el entorno local. No subir .env al repositorio.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vacío permite SQLite en local. Docker Compose utiliza su propio PostgreSQL.
DATABASE_URL=
DATABASE_SSL_REQUIRE=false
LOCAL_CURRENCY=EUR
# Valor ilustrativo del enunciado, NO una cotización actual.
DEFAULT_EXCHANGE_RATE=0.85
SECURE_SSL_REDIRECT=false
TRUST_PROXY_HEADERS=false
PORT=8000
