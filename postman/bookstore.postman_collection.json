          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.environment.set(\"basic_token\", pm.response.json().token);"
            ]
          }
        }
