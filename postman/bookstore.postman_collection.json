{
  "info": {
    "name": "Nextep - Bookstore Inventory API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Requiere admin_username y admin_password privados en el entorno. Crea y elimina su libro; crea un usuario temporal y lo desactiva al terminar. Verifica autenticación, permisos y revocación. No exportar contraseñas ni tokens. Seleccionar entorno Local o Producción. Producción está pendiente hasta configurar una URL real con scripts/configure_postman.py."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://pruebanextep.dateoapp.com"
    },
    {
      "key": "book_id",
      "value": ""
    },
    {
      "key": "demo_isbn",
      "value": ""
    },
    {
      "key": "calculated_price",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.get(\"base_url\");",
          "if (!base || !/^https?:\\/\\//.test(base)) throw new Error(\"Configura base_url con la URL real de la API antes de ejecutar.\");"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Login completo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Rol completo\", () => pm.expect(pm.response.json().user.role).to.eql(\"full\"));",
              "if (pm.response.code === 200) pm.environment.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Mi cuenta",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Sin token no hay acceso",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/books",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Aplicación disponible\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Base de datos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Base disponible\", () => pm.expect(pm.response.json().database).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Crear libro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Libro de prueba Postman\",\n  \"author\": \"Evaluación Nextep\",\n  \"isbn\": \"{{demo_isbn}}\",\n  \"cost_usd\": \"15.99\",\n  \"stock_quantity\": 25,\n  \"category\": \"Novela\",\n  \"supplier_country\": \"ES\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"book_id\", pm.response.json().id);",
              "pm.test(\"Precio aún no calculado\", () => pm.expect(pm.response.json().selling_price_local).to.eql(null));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const prefix = \"978\" + String(Date.now()).slice(-9);",
              "const sum = [...prefix].reduce((total, c, i) => total + Number(c) * (i % 2 ? 3 : 1), 0);",
              "pm.collectionVariables.set(\"demo_isbn\", prefix + ((10 - sum % 10) % 10));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Listar libros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Lista paginada\", () => pm.expect(pm.response.json().results).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Consultar libro",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/books/{{book_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"ID creado\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"book_id\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Rechazar ISBN duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Libro de prueba Postman\",\n  \"author\": \"Evaluación Nextep\",\n  \"isbn\": \"{{demo_isbn}}\",\n  \"cost_usd\": \"15.99\",\n  \"stock_quantity\": 25,\n  \"category\": \"Novela\",\n  \"supplier_country\": \"ES\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Error ISBN\", () => pm.expect(pm.response.json().error.details).to.have.property(\"isbn\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Rechazar costo cero",
      "request": {
        "method": "POST",
